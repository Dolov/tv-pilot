# tv-pilot 本机配置示例
#
# 用法：复制为同目录的 .env 再填写。.env 已被 .gitignore 排除，不会进仓库。
#       也可以放在仓库根目录（仅当 skill 位于 <repo>/.agents/skills/tv-pilot 时生效）。
#
# 原则：所有因机器而异的敏感信息都放这里，文档和脚本里只留占位符。

# 电视局域网地址（冷启动时 ensure-tv.sh 的第一跳，不扫网段）
TV_IP=192.168.1.123
TV_PORT=5555

# 遥控器蓝牙 MAC（可选，便于核对 bluetooth_hid_battery_<MAC> 电量键；脚本会自动发现）
REMOTE_MAC=AA:BB:CC:DD:EE:FF

# 签名 keystore 密码（可选，默认 android；换了自己的 keystore 再改）
TVPILOT_KS_PASS=android
