<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.dsh.tvhud"
    android:versionCode="23"
    android:versionName="1.22">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="22" />

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:label="tv-pilot"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:allowBackup="false">

        <!-- 启动页：菜单。以后加功能只改 HomeActivity.ITEMS -->
        <activity
            android:name="com.dsh.tvhud.home.HomeActivity"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:icon="@mipmap/ic_launcher"
            android:banner="@drawable/tv_banner"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 详情页：时间轴 + 分段明细（从菜单进，返回键回菜单） -->
        <activity
            android:name="com.dsh.tvhud.usage.MainActivity"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:exported="true"
            android:launchMode="singleTop" />

        <!-- 使用报告：周报 / 月报 / 年报三套布局（从菜单进，返回键回菜单） -->
        <activity
            android:name="com.dsh.tvhud.report.ReportsActivity"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:launchMode="singleTop"
            android:exported="false" />

        <!-- 电子宠物：宠物房间 / 到点拦截 / 家长设置 -->
        <activity
            android:name="com.dsh.tvhud.pet.PetActivity"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:launchMode="singleTop"
            android:exported="false" />
        <activity
            android:name="com.dsh.tvhud.pet.PetGateActivity"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity
            android:name="com.dsh.tvhud.pet.PetSettingsActivity"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:launchMode="singleTop"
            android:exported="false" />
        <activity
            android:name="com.dsh.tvhud.pet.PetReportActivity"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:launchMode="singleTop"
            android:exported="false" />

        <service
            android:name="com.dsh.tvhud.hud.HudService"
            android:exported="false" />

        <service
            android:name="com.dsh.tvhud.hud.BootAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.dsh.tvhud.hud.CtrlReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.dsh.tvhud.SHOW" />
                <action android:name="com.dsh.tvhud.HIDE" />
                <action android:name="com.dsh.tvhud.ADB_KEEP_ON" />
                <action android:name="com.dsh.tvhud.ADB_KEEP_OFF" />
                <action android:name="com.dsh.tvhud.PREVIEW_ON" />
                <action android:name="com.dsh.tvhud.PREVIEW_OFF" />
                <action android:name="com.dsh.tvhud.RESET_USAGE" />
                <action android:name="com.dsh.tvhud.RELOAD_PLAYS" />
                <action android:name="com.dsh.tvhud.ARCHIVE_NOW" />
                <action android:name="com.dsh.tvhud.PET_RESET" />
                <action android:name="com.dsh.tvhud.PET_RELOAD" />
                <action android:name="com.dsh.tvhud.PET_GATE" />
                <action android:name="com.dsh.tvhud.PET_SETTINGS" />
                <action android:name="com.dsh.tvhud.PET_NEAR_END" />
                <action android:name="com.dsh.tvhud.PET_DEBUG" />
                <action android:name="com.dsh.tvhud.PET_PARENT_ON" />
                <action android:name="com.dsh.tvhud.PET_PARENT_OFF" />
                <action android:name="com.dsh.tvhud.PET_SHOP" />
                <action android:name="com.dsh.tvhud.PET_BRANCH" />
                <action android:name="com.dsh.tvhud.PET_MUTATE" />
                <action android:name="com.dsh.tvhud.PET_DEGRADE" />
                <action android:name="com.dsh.tvhud.PET_GIVE_STARS" />
                <action android:name="com.dsh.tvhud.PET_WINDOW_ON" />
                <action android:name="com.dsh.tvhud.PET_WINDOW_OFF" />
                <action android:name="com.dsh.tvhud.PET_WEEKEND_ON" />
                <action android:name="com.dsh.tvhud.PET_WEEKEND_OFF" />
                <action android:name="com.dsh.tvhud.PET_GENTLE_ON" />
                <action android:name="com.dsh.tvhud.PET_GENTLE_OFF" />
                <action android:name="com.dsh.tvhud.PET_ROOM" />
                <action android:name="com.dsh.tvhud.PET_REPORT" />
                <action android:name="com.dsh.tvhud.PET_STATE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.dsh.tvhud.hud.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
